diff --git a/fiedle400/engine/cms50f37.py b/fiedle400/engine/cms50f37.py
new file mode 100644
index 0000000..a4d653f
--- /dev/null
+++ b/fiedle400/engine/cms50f37.py
@@ -0,0 +1,213 @@
+"""Read-only engine for protocol-B devices: Contec CMS50F v3.7, CMS50I, CMS50H (PROTOCOL.md §6).
+
+It offers the parts of `SerialDeviceEngine`'s interface the CLI uses for `info`, `sessions` and
+`download`. Everything that writes to the device (erase, clock) or streams live data is refused
+here and never sent: fiedle400 only downloads from these models (T-061).
+
+Built from OSCAR's `cms50f37_loader.cpp` and replayed against a real CMS50F 3.7 capture
+(tests/fixtures/cms50f37-download.trace.json); untested on a device by the project.
+"""
+
+import time
+from datetime import datetime, timedelta
+from typing import Any, Callable, Dict, List, Optional, Tuple, Union
+
+from ..protocol import DeviceInfo, SessionInfo
+from ..protocol import cms50f37 as b
+
+REPLY_TIMEOUT = 1.0    # OSCAR waits up to 2 s; the capture answers within about 30 ms
+QUIET_END = 2.0        # the device just stops sending at the end of a recording (OSCAR: 2 s)
+PROGRESS_EVERY = 3600  # samples between progress lines (one hour of recording)
+
+Frames = List[Tuple[int, bytes]]
+
+
+class Cms50F37Engine:
+    """Protocol-B counterpart of `SerialDeviceEngine` (download only)."""
+
+    protocol = "cms50f37"
+
+    def __init__(self, device, background_reader: bool = False):
+        self.dev = device
+        self.model: Optional[str] = getattr(device, "model_string", None)
+        self.single_erase_unsupported = False
+        self.download_warnings: List[str] = []
+        self._rest = b""
+        self._sleep = time.sleep
+        self._clock = time.time
+
+    def close(self):
+        pass
+
+    # --- transport -------------------------------------------------------------------------
+    def _send(self, opcode: int, session: int = 0, debug: Union[bool, int] = 0) -> None:
+        cmd = b.build_command(opcode, session=session)
+        if int(debug) >= 1:
+            print(f"[DEBUG OUT] CMS50F37: {cmd.hex(' ')}")
+        self.dev.write_raw(cmd)
+
+    def _read_frames(self, done: Callable[[Frames], bool], timeout: float = REPLY_TIMEOUT,
+                     debug: Union[bool, int] = 0) -> Frames:
+        """Reads frames until `done(frames)` or `timeout` seconds without a new byte."""
+        frames: Frames = []
+        last = self._clock()
+        while not done(frames):
+            rep = self.dev.read_report(64)
+            if rep:
+                last = self._clock()
+                if int(debug) >= 2:
+                    print(f"[DEBUG IN] CMS50F37: {bytes(rep).hex(' ')}")
+                got, self._rest = b.split_frames(self._rest + bytes(rep))
+                frames.extend(got)
+            elif self._clock() - last >= timeout:
+                break
+            else:
+                self._sleep(0.005)
+        return frames
+
+    def _ask(self, opcode: int, want: int, session: int = 0, count: int = 1,
+             debug: Union[bool, int] = 0) -> Frames:
+        self._send(opcode, session=session, debug=debug)
+        return self._read_frames(lambda fr: sum(1 for c, _ in fr if c == want) >= count, debug=debug)
+
+    def _hello(self, debug: Union[bool, int] = 0) -> None:
+        """`A7` then `A2`: stops any stream, as OSCAR and SpO2 Assistant do before each step."""
+        self._rest = b""
+        self._ask(b.HELLO1, b.REPLY_HELLO, debug=debug)
+        self._ask(b.HELLO2, b.REPLY_HELLO, debug=debug)
+
+    # --- queries ---------------------------------------------------------------------------
+    def read_raw_report(self, timeout: float = 0.0) -> Optional[bytes]:
+        return self.dev.read_report(64)
+
+    def unlock_handshake(self, debug: Union[bool, int] = 0) -> int:
+        self._hello(debug=debug)
+        return 1
+
+    def read_model(self, debug: Union[bool, int] = 0) -> Optional[str]:
+        if self.model is None:
+            self.model = b.model_from_frames(self._ask(b.MODEL, b.REPLY_MODEL, count=2, debug=debug))
+        return self.model
+
+    def read_device_info(self, debug: Union[bool, int] = 0) -> Dict[str, Any]:
+        self._hello(debug=debug)
+        info = DeviceInfo()
+        info.hardware_id = self.read_model(debug=debug)
+        counted = b.session_count(self._ask(b.SESSION_COUNT, b.REPLY_COUNT, debug=debug))
+        return {
+            "device_info": info,
+            "active_user_id": (counted[0] + 1) if counted else 1,
+            "rtc_time_str": "not read (CMS50F v3.7 protocol)",
+        }
+
+    def list_sessions(self, debug: Union[bool, int] = 0, attempts: int = 2, retry_delay: float = 0.3) -> List[SessionInfo]:
+        for attempt in range(attempts):
+            sessions = self._list_sessions_once(debug=debug)
+            if sessions or attempt == attempts - 1:
+                return sessions
+            self._sleep(retry_delay)
+        return []
+
+    def _list_sessions_once(self, debug: Union[bool, int] = 0) -> List[SessionInfo]:
+        self._hello(debug=debug)
+        divisor = b.duration_divisor(self.read_model(debug=debug))
+        counted = b.session_count(self._ask(b.SESSION_COUNT, b.REPLY_COUNT, debug=debug))
+        if not counted:
+            return []
+        user, count = counted
+        sessions = []
+        for index in range(count):
+            units = b.duration_units(self._ask(b.SESSION_DURATION, b.REPLY_DURATION, session=index, debug=debug))
+            start = b.session_start(self._ask(b.SESSION_TIME, b.REPLY_TIME, session=index, debug=debug))
+            n = (units or 0) // divisor
+            sessions.append(SessionInfo(session_id=index + 1, user_id=user + 1, record_count=n,
+                                        duration_sec=n, raw_samples=n,
+                                        timestamp=start.as_datetime() if start else None))
+        return sessions
+
+    # --- download --------------------------------------------------------------------------
+    def download_session(self, sess_info: SessionInfo, debug: Union[bool, int] = 0) -> List[Dict[str, Any]]:
+        """`A7`, `A2`, then `A6 [session]`; the device streams data frames and goes quiet at the end."""
+        expected = sess_info.record_count
+        base = sess_info.timestamp or datetime.now()
+        self._hello(debug=debug)
+        self._send(b.SESSION_DATA, session=sess_info.session_id - 1, debug=debug)
+
+        pairs: List[Tuple[Optional[int], Optional[int]]] = []
+        next_note = PROGRESS_EVERY
+
+        def done(frames: Frames) -> bool:
+            nonlocal next_note
+            while frames:
+                code, data = frames.pop(0)
+                pairs.extend(b.samples(code, data))
+            if len(pairs) >= next_note:
+                print(f"  ... {len(pairs):,} of {expected:,} samples")
+                next_note += PROGRESS_EVERY
+            return expected > 0 and len(pairs) >= expected
+
+        self._read_frames(done, timeout=QUIET_END, debug=debug)
+        if expected > 0 and len(pairs) >= expected:
+            pairs = pairs[:expected]
+        else:
+            self._send(b.HELLO1, debug=debug)  # stop a stream that may still be running
+
+        out = []
+        for i, (spo2, pulse) in enumerate(pairs):
+            out.append({
+                "session_id": sess_info.session_id,
+                "user_id": sess_info.user_id,
+                "block_id": 1,
+                "seq": i,
+                "timestamp": (base + timedelta(seconds=i)).isoformat(),
+                "spo2": spo2,
+                "heart_rate": pulse,
+                "flags": "ok" if spo2 is not None else "probe-out",
+            })
+        print(f"\nSession #{sess_info.session_id} download complete ({len(out)} records).")
+        if expected and len(out) < expected:
+            warning = (f"the device sent {len(out)} of the {expected} samples it announced for recording "
+                       f"#{sess_info.session_id}; the rest is missing. Download it again.")
+            print(f"WARNING: {warning}")
+            self.download_warnings.append(warning)
+        return out
+
+    def download_all_sessions(self, target_session: int = 0, download_all: bool = True,
+                              timeout_override: float = 0, debug: Union[bool, int] = 0,
+                              dump_file: Optional[str] = None) -> List[Dict[str, Any]]:
+        if dump_file:
+            print("Note: --dump is not supported for CMS50F v3.7 devices; use -vv to see the traffic.")
+        sessions = self.list_sessions(debug=debug)
+        if not download_all and target_session > 0:
+            sessions = [s for s in sessions if s.session_id == target_session]
+            if not sessions:
+                print(f"Recording #{target_session} is not on the device.")
+                return []
+        if not sessions:
+            print("No recordings on the device.")
+            return []
+        print(f"Found {len(sessions)} session(s) to download: {[s.session_id for s in sessions]}")
+        records: List[Dict[str, Any]] = []
+        for s in sessions:
+            if timeout_override > 0:
+                s.record_count = min(s.record_count, int(timeout_override)) if s.record_count else int(timeout_override)
+                s.duration_sec = s.record_count
+            print(f"\n---> Requesting Session #{s.session_id} ({s.duration_str})...")
+            records.extend(self.download_session(s, debug=debug))
+        return records
+
+    # --- refused ---------------------------------------------------------------------------
+    def read_packets(self, base_timestamp=None, debug: Union[bool, int] = 0) -> list:
+        return []  # live mode is out of scope (T-061)
+
+    def read_rtc_time(self, debug: Union[bool, int] = 0) -> Optional[bytes]:
+        return None
+
+    def set_rtc_time(self, target_dt=None, debug: Union[bool, int] = 0) -> bool:
+        print("Setting the clock is not supported for CMS50F v3.7 devices.")
+        return False
+
+    def clear_memory(self, session_id: int = 0, debug: Union[bool, int] = 0) -> bool:
+        """Never erases: these models are download-only in fiedle400 (`0xAE` is never sent)."""
+        print("Erase is not supported for CMS50F v3.7 devices; erase recordings on the device itself.")
+        return False
