diff --git a/fiedle400/protocol/cms50f37.py b/fiedle400/protocol/cms50f37.py
new file mode 100644
index 0000000..0150f3d
--- /dev/null
+++ b/fiedle400/protocol/cms50f37.py
@@ -0,0 +1,169 @@
+"""Protocol B: the Contec CMS50F v3.7 serial protocol (CMS50F firmware 3.7, CMS50I, CMS50H).
+
+A different protocol from the PO-400's (PROTOCOL.md §6). Taken from OSCAR's
+`cms50f37_loader.cpp` and checked byte for byte against a real CMS50F 3.7 download by SpO2
+Assistant 2.x (`tests/fixtures/cms50f37-download.trace.json`, PROTOCOL.md §6.1):
+
+- Requests are always 9 bytes: `7D 81 [op] [user] [session] 80 80 80 80`, every byte after the
+  prefix with bit 7 set, no checksum.
+- Replies are `[code 00..1F] [high bits] [data…]`; the length depends on the code (`LENGTHS`).
+  Bit k of the second byte is bit 7 of data byte k.
+
+Only read-only commands are here. `0xAE` (erase a recording) and `0xAA` (which is
+`FLASH_CLEAR` in the PO-400's protocol) are deliberately left out.
+"""
+
+from dataclasses import dataclass
+from datetime import datetime
+from typing import List, Optional, Tuple
+
+HELLO1 = 0xA7         # stop stored data stream; answered with code 0x0C
+HELLO2 = 0xA2         # stop live data stream; answered with code 0x0C
+SESSION_COUNT = 0xA3  # code 0x0A
+SESSION_DURATION = 0xA4  # code 0x08
+SESSION_TIME = 0xA5   # codes 0x07 (date) and 0x12 (time)
+SESSION_DATA = 0xA6   # codes 0x0F (CMS50F) or 0x09 (CMS50I, with PI)
+MODEL = 0xA8          # code 0x02, two frames
+VENDOR = 0xA9         # code 0x03
+
+REPLY_MODEL = 0x02
+REPLY_VENDOR = 0x03
+REPLY_DATE = 0x07
+REPLY_DURATION = 0x08
+REPLY_DATA_PI = 0x09
+REPLY_COUNT = 0x0A
+REPLY_HELLO = 0x0C
+REPLY_DATA = 0x0F
+REPLY_TIME = 0x12
+
+# Frame length per reply code (OSCAR's table). 0 = not a reply code.
+LENGTHS = (0, 0, 9, 9, 9, 9, 4, 8, 8, 6, 4, 4, 2, 0, 3, 8, 3, 9, 8, 9, 9) + (0,) * 11
+
+INVALID_PULSE = 0xFF  # a data sample with this pulse value is "no reading" (OSCAR)
+
+
+def build_command(opcode: int, session: int = 0, user: int = 0) -> bytes:
+    """A 9-byte request. Session and user indexes start at 0 (OSCAR puts the session in byte 4)."""
+    return bytes([0x7D, 0x81, opcode | 0x80, (user & 0x7F) | 0x80, (session & 0x7F) | 0x80,
+                  0x80, 0x80, 0x80, 0x80])
+
+
+def split_frames(buf: bytes) -> Tuple[List[Tuple[int, bytes]], bytes]:
+    """Cuts a byte stream into (code, data) frames, data with bit 7 restored.
+
+    Bytes that cannot start a frame are skipped. Returns the frames and the incomplete rest,
+    to be prefixed to the next read.
+    """
+    frames: List[Tuple[int, bytes]] = []
+    i = 0
+    while i < len(buf):
+        code = buf[i]
+        length = LENGTHS[code & 0x1F] if code < 0x80 else 0
+        if length == 0:
+            i += 1
+            continue
+        if i + length > len(buf):
+            break
+        hi = buf[i + 1]
+        data = bytes((b & 0x7F) | (0x80 if (hi >> k) & 1 else 0) for k, b in enumerate(buf[i + 2:i + length]))
+        frames.append((code, data))
+        i += length
+    return frames, bytes(buf[i:])
+
+
+def _text(data: bytes) -> str:
+    return data.replace(b"\x00", b" ").decode("ascii", errors="replace").strip()
+
+
+def model_from_frames(frames: List[Tuple[int, bytes]]) -> Optional[str]:
+    """The model string from the `0x02` frames: the first carries data[0] == 0, a second one
+    (data[0] != 0) may continue it. None if no `0x02` frame came."""
+    parts = [(d[0], d[1:7]) for c, d in frames if c == REPLY_MODEL and len(d) >= 7]
+    if not parts:
+        return None
+    first = next((t for k, t in parts if k == 0), parts[0][1])
+    extra = b"".join(t for k, t in parts if k != 0)
+    model = (_text(first) + _text(extra)).strip()
+    return model or None
+
+
+def vendor_from_frames(frames: List[Tuple[int, bytes]]) -> Optional[str]:
+    for code, data in frames:
+        if code == REPLY_VENDOR:
+            return _text(data) or None
+    return None
+
+
+def duration_divisor(model: Optional[str]) -> int:
+    """`A4` counts half seconds on a CMS50F and quarter seconds on a CMS50I/CMS50H (OSCAR)."""
+    m = (model or "").upper()
+    return 4 if m.startswith(("CMS50I", "CMS50H")) else 2
+
+
+@dataclass
+class SessionStart:
+    year: int
+    month: int
+    day: int
+    hour: Optional[int] = None
+    minute: Optional[int] = None
+    second: Optional[int] = None
+
+    def as_datetime(self) -> Optional[datetime]:
+        """None if the device sent no date (year 0, as a CMS50D+ in this protocol would)."""
+        if self.year == 0 or self.hour is None:
+            return None
+        try:
+            return datetime(self.year, self.month, self.day, self.hour, self.minute or 0, self.second or 0)
+        except ValueError:
+            return None
+
+
+def session_start(frames: List[Tuple[int, bytes]]) -> Optional[SessionStart]:
+    """Date (`0x07`: century and year as two decimal halves, month, day) and time (`0x12`)."""
+    start = None
+    for code, d in frames:
+        if code == REPLY_DATE and len(d) >= 6:
+            start = SessionStart(year=d[2] * 100 + d[3], month=d[4], day=d[5])
+    if start is None:
+        return None
+    for code, d in frames:
+        if code == REPLY_TIME and len(d) >= 5:
+            start.hour, start.minute, start.second = d[2], d[3], d[4]
+    return start
+
+
+def duration_units(frames: List[Tuple[int, bytes]]) -> Optional[int]:
+    for code, d in frames:
+        if code == REPLY_DURATION and len(d) >= 6:
+            return d[2] | (d[3] << 8) | (d[4] << 16) | (d[5] << 24)
+    return None
+
+
+def session_count(frames: List[Tuple[int, bytes]]) -> Optional[Tuple[int, int]]:
+    """(user index, number of recordings) from the `0x0A` reply."""
+    for code, d in frames:
+        if code == REPLY_COUNT and len(d) >= 2:
+            return d[0], d[1]
+    return None
+
+
+def samples(code: int, data: bytes) -> List[Tuple[Optional[int], Optional[int]]]:
+    """(SpO2, pulse) pairs of one data frame; (None, None) for a sample without a reading.
+
+    `0x0F` holds three samples (SpO2, pulse each); `0x09` holds one sample plus a perfusion
+    index, which fiedle400 does not keep.
+    """
+    if code == REPLY_DATA:
+        pairs = [(data[k], data[k + 1]) for k in range(0, min(len(data), 6) - 1, 2)]
+    elif code == REPLY_DATA_PI and len(data) >= 2:
+        pairs = [(data[0], data[1])]
+    else:
+        return []
